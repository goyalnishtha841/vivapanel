# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
GITHUB_TOKEN=

# Agent tuning
VIVA_MODEL=claude-opus-5-5
VIVA_EFFORT=low
# Set to 1 to run agents with a scripted offline examiner (no API calls, no cost)
VIVA_OFFLINE=0

# Groq instead of Claude (free tier: 8k tokens/min per model)
# VIVA_PROVIDER=groq
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_FAST_MODEL=openai/gpt-oss-20b
# VIVA_FAST_ROLES=junior          # examiners on the fast model
# VIVA_DEBUG=1                    # print latency and tokens per call

# Gemini backup (Google AI Studio key). Used automatically when the primary provider is rate-limited:
# primary big -> primary fast -> Gemini flash -> Gemini flash-lite. Set the key and it's on.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_FAST_MODEL=gemini-flash-lite-latest
# VIVA_BACKUP_PROVIDER=gemini     # default when GEMINI_API_KEY is set
# GEMINI_TIMEOUT_MS=45000

# Test sandbox for real repos (the Engineer runs the student's own pytest suite, isolated).
# Locally it uses Docker if it's running. On hosts without Docker (Render), set an E2B key (e2b.dev, free tier).
# E2B_API_KEY=
# VIVA_SANDBOX=auto               # auto | docker | e2b | off         # a slower call falls through to the next model

# Storage: Postgres keeps sessions and report links across restarts (Render's free disk is wiped on restart).
# Free database: neon.tech or supabase.com -> copy the connection string. Empty = SQLite in backend/data.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Public demo limits (rolling 24 h). 0 = no cap. Interview links are exempt from the per-visitor cap.
# VIVA_DAILY_SESSIONS=40
# VIVA_DAILY_PER_VISITOR=6
# Repo copies of abandoned vivas are deleted after this many idle hours (reports are kept).
# VIVA_CLEANUP_AFTER_H=3
