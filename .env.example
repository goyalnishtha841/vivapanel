# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
GITHUB_TOKEN=

# Agent tuning
VIVA_MODEL=claude-opus-5-5
VIVA_EFFORT=low
# Set to 1 to run agents with a scripted offline examiner (no API calls, no cost)
VIVA_OFFLINE=0

# Groq instead of Claude (free tier: 8k tokens/min per model)
# VIVA_PROVIDER=groq
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_FAST_MODEL=openai/gpt-oss-20b
# VIVA_FAST_ROLES=junior          # examiners on the fast model
# VIVA_DEBUG=1                    # print latency and tokens per call
